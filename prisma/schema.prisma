generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CompanionMode {
  FAMILY
  FRIEND
  LOVER
  TEACHER
  STUDENT
  MENTOR
  OTHER
}

model User {
  id        String      @id @default(uuid())
  username  String?     @unique
  chat_id   String?     @unique
  name      String?
  password  String?
  memory    UserMemory?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model UserMemory {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName         String?
  userAge          String?
  currentMode      CompanionMode      @default(FRIEND)
  favourite        Json?
  studies          Json?
  friends          Json?
  dailyRoutine     Json?
  facts            Json?
  pastConversation PastConversation[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}


model PastConversation {
  id               String     @id @default(uuid())
  userMemoryId     String
  userMemory       UserMemory @relation(fields: [userMemoryId], references: [id], onDelete: Cascade)
  lastConversation DateTime   @default(now())
  topic            String
  lastMessage      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}
