generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanionMode {
  FAMILY
  FRIEND
  LOVER
  TEACHER
  STUDENT
  MENTOR
  OTHER
}

model User {
  id                String              @id @default(uuid())
  username          String?             @unique
  chat_id           String?             @unique
  name              String?
  password          String?
  memory            UserMemory?
  lastInteractionAt DateTime?
  scheduledMessages ScheduledMessage[]
  proactiveMessages ProactiveMessageLog[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model UserMemory {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName         String?
  userAge          String?
  currentMode      CompanionMode      @default(FRIEND)
  favourite        Json?
  studies          Json?
  friends          Json?
  dailyRoutine     Json?
  facts            Json?
  pastConversation PastConversation[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model PastConversation {
  id               String     @id @default(uuid())
  userMemoryId     String
  userMemory       UserMemory @relation(fields: [userMemoryId], references: [id], onDelete: Cascade)
  lastConversation DateTime   @default(now())
  topic            String
  lastMessage      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

enum ScheduledMessageStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

model ScheduledMessage {
  id              String                 @id @default(uuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bullJobId       String?                @unique
  scheduledAt     DateTime
  lastUserMessage String
  status          ScheduledMessageStatus @default(PENDING)
  reason          String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([userId, status])
  @@index([scheduledAt])
}

model ProactiveMessageLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageSent String
  context     String?
  aiDecision  Json?
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([sentAt])
}
